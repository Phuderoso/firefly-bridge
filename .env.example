# Copy to a file that is not committed. Values below are empty or neutral placeholders.
# Do not put key material, tokens, or live hostnames in this file.
# Paths may use ~ and environment variables; they are expanded at load time.

# Config file. When unset, the loader looks at $XDG_CONFIG_HOME/firefly-bridge/config.toml.
FIREFLY_BRIDGE_CONFIG=

# Identity. Defaults are the placeholders agent-a / agent-b / agent-c, all pending.
FIREFLY_BRIDGE_SENDER=
FIREFLY_BRIDGE_PREFIX=
FIREFLY_BRIDGE_AGENTS=
FIREFLY_BRIDGE_IPC_PRINCIPAL=
FIREFLY_BRIDGE_RELAY_PRINCIPAL=

# Permission modes. Leave unset for pending. allow_all_own_turns is opt-in and off.
FIREFLY_BRIDGE_PERMISSION_MODE=
FIREFLY_BRIDGE_AGENT_A_PERMISSION_MODE=
FIREFLY_BRIDGE_AGENT_B_PERMISSION_MODE=
FIREFLY_BRIDGE_AGENT_C_PERMISSION_MODE=

# Target. Live send stays off until FIREFLY_BRIDGE_LIVE_SEND=true.
FIREFLY_BRIDGE_SOCKET_PATH=
FIREFLY_BRIDGE_SESSION_ID=
FIREFLY_BRIDGE_SESSION_CWD=
FIREFLY_BRIDGE_GROK_BIN=
FIREFLY_BRIDGE_LIVE_SEND=
FIREFLY_BRIDGE_STRIP_GROK_SANDBOX=
FIREFLY_BRIDGE_ADAPTER_MODE=

# HMAC and IPC key files (mode 0600). Point at files. Never paste key bytes here.
FIREFLY_BRIDGE_AUTH_MODE=
FIREFLY_BRIDGE_HMAC_KEY_FILE=
FIREFLY_BRIDGE_IPC_KEYS_DIR=
FIREFLY_BRIDGE_IPC_KEY_FILE=

# State and wake files. Filenames are neutral defaults.
FIREFLY_BRIDGE_STATE_DIR=
FIREFLY_BRIDGE_WAKE_DIR=
FIREFLY_BRIDGE_WAKE_FILENAME=
FIREFLY_BRIDGE_REPLY_PREFIX=
FIREFLY_BRIDGE_INBOUND_DIR=
FIREFLY_BRIDGE_UPDATES_JSONL_PATH=
FIREFLY_BRIDGE_HOLD_PID_FILE=
FIREFLY_BRIDGE_APPROVALS_LOG_PATH=
FIREFLY_BRIDGE_LEDGER_PATH=
FIREFLY_BRIDGE_SHARED_DIR=

# GitHub comment channel. Placeholders only.
FIREFLY_BRIDGE_GITHUB_CANAL_REPO=
FIREFLY_BRIDGE_GITHUB_CANAL_PR=

# Shell helpers (scripts/channel-call, scripts/channel-knock).
CHANNEL_GH=
CHANNEL_FROM=
CHANNEL_SENDERS=
CHANNEL_RELAY=
CHANNEL_KNOCK_LIVE=
CHANNEL_STATE_DIR=
CHANNEL_TZ=
CHANNEL_PRESENCE_NONCES=

# Preflight and local ledger. Execute stays off unless both the flag and this variable are set.
AGENT_PREFLIGHT_EXECUTE=
AGENT_SESSION_CWD=
AGENT_LEDGER=
PINNED_SESSION_ID=
FIREFLY_BRIDGE_SPEAKER=
